# ── Auth secrets ───────────────────────────────────────────────────────────
# ADMIN_TOKEN protects /admin/* — compare via constant-time comparison.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=CHANGE_ME

# JWT_SECRET signs/verifies user session tokens for the luv13 website.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# ── Browser login for /admin/* (optional) ───────────────────────────────────
# Lets you access /admin/summary from any browser at /admin/login.
# If unset, only the X-Admin-Token header (ADMIN_TOKEN above) works.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_TTL_DAYS=7

# ── Optional tunables (defaults shown) ─────────────────────────────────────
# NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
# Flat-rate revenue: $0.33 per million tokens on every token (input/output/cached).
# YOUR_INPUT_PRICE_PER_M=0.33
# YOUR_OUTPUT_PRICE_PER_M=0.33
# YOUR_CACHED_INPUT_PRICE_PER_M=0.33
# Blended upstream cost fallback ($/M) when response omits cost.
# BLENDED_COST_PER_M=0.20
# MAX_KEYS_PER_CUSTOMER=5

# ── Concurrency-slot router (replaces time-based cooldowns) ─────────────────
# Hard cap of concurrent in-flight requests per Neuralwatt account.
# PROXY_ACCOUNT_MAX_CONCURRENCY=3
# Park duration after a genuine auth/budget error (401/402/403) — the only
# long-duration account removal left. 429s never blacklist.
# PROXY_BUDGET_COOLDOWN=300
# Breather after a 5xx/connection error (seconds).
# PROXY_ERROR_PAUSE=1.0
# Jitter window before retrying after an unexpected 429 (seconds).
# PROXY_429_RETRY_WAIT_MIN=0.2
# PROXY_429_RETRY_WAIT_MAX=0.5
# How long the local counter reads "full" after an unexpected 429 (ms).
# PROXY_429_SYNC_TTL_MS=1000
# How often the in-flight sampler logs per-account slot counts (seconds).
# PROXY_INFLIGHT_LOG_INTERVAL=5
# Soft cache affinity: prefer last-served account only as a least-loaded
# tie-break (never pins a customer to a busier account). 1=on, 0=off.
# PROXY_CACHE_AFFINITY=1
# Delayed hedge (streaming only): second account if primary is slow to
# first token. Off by default. Isolate mode never hedges.
# PROXY_HEDGE_ENABLED=0
# PROXY_HEDGE_AFTER_MS=2500

# ── SSE forward path ───────────────────────────────────────────────────────
# Optional OpenAI-schema hygiene (strip Neuralwatt extras, inject role).
# Default OFF — pass-through; Multitask regressed when mutation was on.
# PROXY_SSE_SANITIZE=0

# ── Temporary live-stream capture (hang diagnosis) ─────────────────────────
# Buffer-then-write raw upstream SSE + forwarded client bytes for recent
# streaming requests. Writes model output to disk — disable once the hang
# is found. Never stores API keys (only account name + key_prefix).
# PROXY_CAPTURE_ENABLED=1
# PROXY_CAPTURE_DIR=/tmp/luv13-live-captures
# PROXY_CAPTURE_MAX_FILES=100
