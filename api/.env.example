# Copy to .env on the deployment host; never commit the populated file.
JWT_SECRET=CHANGE_ME
COOKIE_DOMAIN=.luv13.ai
FRONTEND_URL=https://luv13.ai
SESSION_TTL_DAYS=7
# Set to the exact reverse-proxy IP/CIDR so Uvicorn can safely honor
# X-Forwarded-For for per-IP login/signup throttles. Never use "*" publicly.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional Google OAuth. Leave blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.luv13.ai/auth/google/callback

# Stripe Checkout. Populate only on the deployment host.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://luv13.ai/top-up/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://luv13.ai/top-up
STRIPE_MAX_TOPUP_CENTS=100000

# Optional override; the container default is /app/config.json.
LUV13_CONFIG=/app/config.json
